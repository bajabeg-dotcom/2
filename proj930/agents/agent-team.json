{
  "schema": "dna-pa800-agent-team",
  "version": "3.1",
  "orchestration": {
    "pattern": "manager-with-parallel-evidence-retrieval-arranger-specialists-and-blocking-validators",
    "manager": "chatgpt-orchestrator",
    "humanApprovalRequiredFor": [
      "export-to-device",
      "overwrite-style",
      "change-factory-dynamics-policy"
    ]
  },
  "invariants": {
    "dynamicsSource": "factory-only",
    "goldAffectsDynamics": false,
    "midiValidatorCannotBeBypassed": true,
    "agentCannotExportMidi": true,
    "structuredPlanRequired": true,
    "coreArrangerWorksWithoutAgents": true,
    "apiKeysStoredInProject": false,
    "arrangerLifecycleAuthority": true,
    "instrumentEngineCannotEndRole": true,
    "variantAIsNotAutomaticallySelected": true,
    "patternEvidenceIndexed": true,
    "globalSectionPathRequired": true,
    "styleTrackAssignmentIsOptimized": true,
    "factoryGoldAuthoritySeparated": true,
    "corpusSourceMidiReadOnly": true,
    "qualityGateBeforeEvidenceAuthority": true,
    "patternProvenanceHashRequired": true
  },
  "agents": [
    {
      "id": "chatgpt-orchestrator",
      "platform": "ChatGPT",
      "role": "manager",
      "responsibilities": [
        "interpret-user-goal",
        "route-specialists",
        "request-approval",
        "summarize-result"
      ],
      "output": "task-plan.json"
    },
    {
      "id": "chatgpt-music-director",
      "platform": "ChatGPT",
      "role": "music-analysis",
      "responsibilities": [
        "genre-brief",
        "form",
        "density",
        "instrument-roles",
        "intensity-curve"
      ],
      "forbidden": [
        "write-midi-bytes",
        "set-gold-velocity"
      ],
      "output": "music-brief.json"
    },
    {
      "id": "chatgpt-style-evaluator",
      "platform": "ChatGPT",
      "role": "musical-evaluation",
      "responsibilities": [
        "compare-variants",
        "evaluate-transitions",
        "explain-recommendation"
      ],
      "requires": [
        "midi-compliance-pass"
      ],
      "output": "style-evaluation.json"
    },
    {
      "id": "codex-lead-engineer",
      "platform": "Codex",
      "role": "implementation",
      "responsibilities": [
        "edit-code",
        "run-tests",
        "update-schemas",
        "update-documentation"
      ],
      "output": "verified-code-change"
    },
    {
      "id": "codex-midi-compliance",
      "platform": "Codex",
      "role": "pa800-validator",
      "responsibilities": [
        "validate-smf0",
        "validate-markers",
        "validate-channels-9-16",
        "validate-cv-controllers"
      ],
      "blocking": true,
      "output": "midi-compliance-report.json"
    },
    {
      "id": "codex-data-regression",
      "platform": "Codex",
      "role": "data-quality",
      "responsibilities": [
        "build-dna",
        "check-id-collisions",
        "check-gold-velocity-zero",
        "compare-baseline"
      ],
      "output": "dna-regression-report.json"
    },
    {
      "id": "chatgpt-section-director",
      "platform": "ChatGPT",
      "role": "section-form-analysis",
      "responsibilities": [
        "detect-section-phrases",
        "build-arrangement-intent",
        "entry-exit-plan",
        "energy-arc"
      ],
      "output": "section-intent.json",
      "forbidden": [
        "write-midi-bytes",
        "override-validator"
      ]
    },
    {
      "id": "chatgpt-continuity-auditor",
      "platform": "ChatGPT",
      "role": "continuity-analysis",
      "responsibilities": [
        "instrument-lifecycle",
        "mid-section-hole-detection",
        "phrase-completion",
        "role-persistence"
      ],
      "output": "continuity-audit.json",
      "forbidden": [
        "write-midi-bytes",
        "override-validator"
      ]
    },
    {
      "id": "chatgpt-power-guitar-director",
      "platform": "ChatGPT",
      "role": "guitar-power-arrangement",
      "responsibilities": [
        "rhythm-guitar-strum-plan",
        "powerchord-lifecycle",
        "guitar-mode-separation",
        "phrase-coverage"
      ],
      "output": "guitar-power-plan.json",
      "forbidden": [
        "write-midi-bytes",
        "override-validator"
      ]
    },
    {
      "id": "chatgpt-rhythm-section-director",
      "platform": "ChatGPT",
      "role": "drums-bass-ensemble",
      "responsibilities": [
        "kick-bass-lock",
        "drum-continuity",
        "bass-lifecycle",
        "groove-pocket"
      ],
      "output": "rhythm-section-plan.json",
      "forbidden": [
        "write-midi-bytes",
        "override-validator"
      ]
    },
    {
      "id": "codex-arranger-core",
      "platform": "Codex",
      "role": "arranger-implementation",
      "responsibilities": [
        "section-lifecycle-engine",
        "global-pattern-path",
        "role-persistence",
        "correction-scope"
      ],
      "output": "verified-arranger-change"
    },
    {
      "id": "codex-pattern-validator",
      "platform": "Codex",
      "role": "pattern-validation",
      "responsibilities": [
        "coverage-tests",
        "loop-tests",
        "phrase-boundary-tests",
        "role-drop-regressions"
      ],
      "output": "pattern-validation-report.json",
      "blocking": true
    },
    {
      "id": "codex-styleworks-roundtrip",
      "platform": "Codex",
      "role": "styleworks-roundtrip",
      "responsibilities": [
        "preserve-styleworks-container",
        "source-output-manifest",
        "roundtrip-diff",
        "unknown-event-preservation"
      ],
      "output": "styleworks-roundtrip-report.json",
      "blocking": true
    },
    {
      "id": "codex-factory-dna-auditor",
      "platform": "Codex",
      "role": "factory-authority",
      "responsibilities": [
        "factory-velocity-only",
        "layer-switch-safety",
        "sound-identity",
        "drum-key-profiles"
      ],
      "output": "factory-dna-report.json",
      "blocking": true
    },
    {
      "id": "codex-gold-evidence-auditor",
      "platform": "Codex",
      "role": "gold-evidence",
      "responsibilities": [
        "gold-pattern-quality",
        "anti-copy",
        "velocity-contamination-check",
        "section-evidence-index"
      ],
      "output": "gold-evidence-report.json",
      "blocking": true
    },
    {
      "id": "codex-fuzz-regression",
      "platform": "Codex",
      "role": "adversarial-testing",
      "responsibilities": [
        "property-tests",
        "mutation-tests",
        "known-bug-fixtures",
        "idempotency",
        "determinism"
      ],
      "output": "fuzz-regression-report.json",
      "blocking": true
