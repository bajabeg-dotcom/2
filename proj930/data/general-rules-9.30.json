  "polyphonyRules": {
    "guitar_strum": {
      "maxVoices": 6,
      "reason": "Gitara = 6 žica max simultano"
    },
    "bass": {
      "maxVoices": 2,
      "reason": "Bass ne svira akorde (izuzetak: double stops)"
    },
    "drums_kit": {
      "maxVoices": 8,
      "reason": "Pa800 polyphony limit per style track"
    },
    "melody": {
      "maxVoices": 1,
      "reason": "Solo linija = monofona (izuzetak: double stops fiddle)"
    },
    "brass_section": {
      "maxVoices": 4,
      "reason": "4-glasni brass je standard na Pa800"
    },
    "acc_chords": {
      "maxVoices": 6,
      "reason": "Standard akord = 6 glasova max"
    },
    "pa800_total": {
      "maxVoices": 54,
      "reason": "Pa800 hard limit = 54 note polyphony"
    }
  },
