{
  "schema": "dna-midi-general-rules",
  "version": "9.30",
  "authority": "GENERAL_RULES_HARD_LIMIT",
  "description": "Hard key range, velocity, polyphony i drum map pravila za Pa800 export. Svaki instrument ima fizički raspon — note izvan raspona su UNPLAYABLE i moraju biti BLOKIRANE pri exportu.",
  "rules": [
    "RULE 1: Note izvan instrument key range = BLOKIRAJ pri export (transponiraj na najbližu validnu ili ukloni)",
    "RULE 2: Velocity ispod instrument minimuma = clamp na ppp vrijednost",
    "RULE 3: Velocity iznad 127 = nemoguće — clamp na 127",
    "RULE 4: Kanal 10 note izvan drum map = BLOKIRAJ (nema zvuka na Pa800)",
    "RULE 5: Polyphony preko instrument max = ukloni najstarije note (FIFO)",
    "RULE 6: Bass nikada ne svira akorde (max 2 note simultano za double stops)",
    "RULE 7: Solo melodija = monofona (max 1 nota istovremeno na istom kanalu)",
    "RULE 8: Ukupna polifonija svih traka zajedno = max 54 (Pa800 hard limit)",
    "RULE 9: Program Change mora biti u GM rasponu 0-127",
    "RULE 10: Bank Select MSB/LSB mora biti validan za Pa800 sound engine"
  ],
